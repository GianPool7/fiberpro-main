<script>

    const billetera=document.getElementById("billetera")

    billetera?.addEventListener('click',()=>{
        const plin=document.getElementById("yape");
        plin.style.display="flex";
        bcp.style.display="none";
        aqui.style.display="none";
    })

    const bancos=document.getElementById("bancos")

    bancos?.addEventListener('click',()=>{
        const bcp=document.getElementById("bcp");
        bcp.style.display="flex";
        plin.style.display="none";
        aqui.style.display="none";

    })

    const presencial=document.getElementById("presencial")

    presencial?.addEventListener('click',()=>{
        const aqui=document.getElementById("aqui");
        aqui.style.display="flex";
        bcp.style.display="none";
        plin.style.display="none";

    })

</script>

